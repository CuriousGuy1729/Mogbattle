# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── PostgreSQL (optional) ─────────────────────────────────────────────────
# When unset, Mogbattle runs with the built-in embedded store
# (JSON-persisted, single node — perfect for local dev / demos).
# For production, point this at a real PostgreSQL instance:
# DATABASE_URL=postgres://mogbattle:mogbattle@localhost:5432/mogbattle
DATABASE_URL=

# ── Redis (optional) ──────────────────────────────────────────────────────
# Used for distributed rate-limiting / anti-farm pair cooldowns when set.
# Falls back to an in-process limiter otherwise.
# REDIS_URL=redis://localhost:6379
REDIS_URL=

# ── Split deployment (e.g. frontend on Vercel) ────────────────────────────
# When the realtime hub runs as a separate service, point the browser at it:
# NEXT_PUBLIC_WS_URL=wss://your-realtime-service.up.railway.app
NEXT_PUBLIC_WS_URL=

# ── Trust & fairness tuning ───────────────────────────────────────────────
# Minimum scan confidence (0..1) required to issue a PSL score.
MIN_SCAN_CONFIDENCE=0.62
# Minutes a verified scan remains valid for RANKED matchmaking.
SCAN_TTL_MINUTES=60
# Prevent rematches between the same pair in random queues (minutes).
REMATCH_COOLDOWN_MINUTES=30
# Max random-queue matches per pair per day.
MAX_DAILY_PAIR_MATCHES=3
# Elo K-factor.
ELO_K=32
