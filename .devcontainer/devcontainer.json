{
  "name": "Mogbattle",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "postCreateCommand": "npm install && npm run build",
  "postAttachCommand": {
    "mogbattle-server": "npm run start"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Mogbattle Arena",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
